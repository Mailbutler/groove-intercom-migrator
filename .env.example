# SAFETY: never point these at production Groove/Intercom accounts for local
# development, ad-hoc testing, or anything other than a real, intentional
# migration run. Use separate sandbox/test-only credentials for everything
# else. Migrations run in dry-run mode by default; live writes require an
# explicit `--live` flag or `MIGRATION_LIVE=1` (see below), but credentials
# themselves are the last line of defense if that safeguard is ever bypassed.
GROOVE_API_BASE_URL=https://api.groovehq.com/v1
GROOVE_API_TOKEN=replace-me

INTERCOM_API_BASE_URL=https://api.intercom.io
INTERCOM_ACCESS_TOKEN=replace-me

# Optional (recommended for deterministic note/reply attribution)
# INTERCOM_FALLBACK_AGENT_ID=123456

# Optional conversation custom attribute used for imported Jira issue keys
# INTERCOM_JIRA_ATTRIBUTE_NAME=jira_issue_key

# Optional migration controls
# MIGRATION_SINCE=2025-01-01T00:00:00.000Z
# MIGRATION_UNTIL=2026-01-01T00:00:00.000Z
# MIGRATION_PER_PAGE=50
# MIGRATION_CONCURRENCY=4

# Migrations are dry-run by default. Set MIGRATION_LIVE=1 (or pass --live)
# to perform real writes to Intercom/Groove. MIGRATION_DRY_RUN=false is also
# honored for backwards compatibility, but MIGRATION_LIVE is preferred since
# its absence is the safe state.
# MIGRATION_LIVE=1
# MIGRATION_MODE=intercom-conversation
# MIGRATION_STRICT_AGENT_MAPPING=false
# JIRA_GROOVE_MAP_FILE=./jira-groove-map.json

# Use a distinctly-named checkpoint file for anything other than the real
# production migration (e.g. ./checkpoint.local-test.json), so a stray or
# accidental run can never resume/overwrite production migration state.
# MIGRATION_CHECKPOINT_FILE=./checkpoint.json
# LOG_LEVEL=info
